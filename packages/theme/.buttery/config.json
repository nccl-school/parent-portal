{
  "$schema": "https://schemas.greenflash.digital/buttery-tokens.json",
  "runtime": {
    "prefix": "nccl",
    "strict": true,
    "suppressStrictWarnings": false
  },
  "sizeAndSpace": {
    "baseFontSize": 16,
    "baselineGrid": 4,
    "size": {
      "variants": {
        "sm": 32,
        "md": 38,
        "lg": 44
      }
    },
    "space": {
      "mode": "auto",
      "variants": 20
    }
  },
  "font": {
    "source": "manual",
    "families": {
      "heading": {
        "family": "Montserrat",
        "fallback": "system-ui, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\"",
        "styles": [
          "regular-400",
          "medium-500",
          "semiBold-600",
          "light-300",
          "bold-700"
        ]
      },
      "body": {
        "family": "Nunito",
        "fallback": "system-ui, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\"",
        "styles": [
          "regular-400",
          "medium-500",
          "semiBold-600",
          "bold-700",
          "light-300"
        ]
      }
    },
    "variants": {
      "heading1": {
        "familyToken": "heading",
        "weight": "medium-500",
        "size": 24,
        "lineHeight": 1.3
      },
      "heading2": {
        "familyToken": "heading",
        "weight": "semiBold-600",
        "size": 18,
        "lineHeight": 1.3
      }
    }
  },
  "response": {
    "breakpoints": {
      "mobile": 480,
      "tablet": 768,
      "laptop": 1024,
      "desktop": 1280,
      "ultraWide": 1536
    }
  },
  "color": {
    "brand": {
      "type": "earth",
      "colors": {
        "primary": {
          "hue": 216,
          "variants": 13
        },
        "secondary": {
          "hue": 171,
          "variants": 13
        },
        "tertiary": {
          "hue": 238,
          "variants": 13
        },
        "success": {
          "hue": 128,
          "variants": 10
        },
        "warning": {
          "hue": 48,
          "variants": 10
        },
        "danger": {
          "hue": 360,
          "variants": 10
        },
        "alt": {
          "hue": 311,
          "variants": 10
        }
      },
      "saturation": 36,
      "brightness": 77
    },
    "neutral": {
      "neutral-dark": {
        "hex": "#29333d",
        "variants": 13
      },
      "hover": {
        "hex": "#c7d8ea",
        "variants": 10
      },
      "neutral-light": {
        "hex": "#91969c",
        "variants": 14
      }
    }
  },
  "custom": {
    "navbar--height-mobile": {
      "type": "rem",
      "value": 72,
      "description": "The height of the navbar"
    },
    "navbar--width-desktop": {
      "type": "rem",
      "value": 72,
      "description": "The width of the navbar"
    },
    "header--height-desktop": {
      "type": "rem",
      "value": 72,
      "description": "The height of the header"
    },
    "page--gutter-desktop": {
      "type": "rem",
      "value": 32,
      "description": "The padding on the side of each page"
    },
    "page--gutter-mobile": {
      "type": "rem",
      "value": 24,
      "description": "The padding on the side of each page"
    },
    "table--cell-padding": {
      "type": "rem",
      "description": "The horizontal padding for each cell",
      "value": 16
    },
    "table--body-cell-padding-v": {
      "type": "rem",
      "description": "The vertical padding on each body cell",
      "value": 16
    },
    "modal--gutters": {
      "type": "rem",
      "description": "The size of the gutters for the modal header footer and body",
      "value": 32
    }
  }
}
