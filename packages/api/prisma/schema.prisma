// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["driverAdapters", "fullTextSearchPostgres"]
  output          = "../src/_generated/prisma"
  moduleFormat    = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SuggestionStatus {
  DISCUSSION
  PLANNED
  IN_PROGRESS
  COMPLETE
}

model Suggestion {
  id          String              @id @default(cuid())
  title       String
  description String
  status      SuggestionStatus    @default(DISCUSSION)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  isAnonymous Boolean             @default(false)
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdById String
  votes       SuggestionVote[]
  comments    SuggestionComment[]
}

enum SuggestionVoteType {
  LIKE
  DISLIKE
}

model SuggestionComment {
  id           String     @id @default(cuid())
  comment      String
  isAnonymous  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdById  String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id])
  suggestionId String
}

model SuggestionVote {
  id           String             @id @default(cuid())
  type         SuggestionVoteType
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdById  String
  suggestion   Suggestion         @relation(fields: [suggestionId], references: [id])
  suggestionId String

  @@unique([createdById, suggestionId])
}

enum RoleName {
  ADMIN
  STAFF
  USER
}

model Role {
  id          RoleName @id @unique
  label       String
  description String
  User        User[]
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String
  emailVerified      Boolean
  imageUrl           String?
  banned             Boolean?                 @default(false)
  banReason          String?
  banExpires         DateTime?
  isSuper            Boolean?                 @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  role               Role                     @relation(fields: [roleId], references: [id])
  roleId             RoleName
  memberships        OrganizationMembership[]
  suggestions        Suggestion[]
  students           UserStudent[]
  groups             UserGroup[]
  suggestionVotes    SuggestionVote[]
  suggestionComments SuggestionComment[]
  resources          Resource[]
  sessions           Session[]
  accounts           Account[]
  image              String?

  @@map("user")
}

model UserGroup {
  id      String  @id @default(cuid())
  User    User?   @relation(fields: [userId], references: [id])
  userId  String?
  Group   Group?  @relation(fields: [groupId], references: [id])
  groupId String?
}

model UserStudent {
  id        String  @id @default(cuid())
  userId    String
  studentId String
  groupId   String
  relation  String // e.g. 'mother', 'father', 'guardian'
  user      User    @relation(fields: [userId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])
  group     Group   @relation(fields: [groupId], references: [id])

  @@unique([userId, studentId])
}

model Student {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  group     String?
  birthDate DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parents   UserStudent[] // ← many-to-many link
  Group     Group?        @relation(fields: [groupId], references: [id])
  groupId   String?
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  teachers    UserGroup[]
  students    Student[]
  UserStudent UserStudent[]
}

model Organization {
  id          String                   @id // Clerk organization ID
  name        String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  Resource    Resource[]
}

model OrganizationMembership {
  id             String       @id // Clerk membership ID
  userId         String
  organizationId String
  role           OrgRole
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Enforcing relational integrity at the DB level
  @@unique([userId, organizationId])
}

enum OrgRole {
  MEMBER
  MANAGER
  PARTICIPANT
}

enum ResourceType {
  FOLDER
  FILE
  LINK
  EXTERNAL_DOC
}

enum FileSource {
  GOOGLE_DOCS
}

model Resource {
  id               String               @id @default(cuid())
  slug             String
  name             String
  description      String?
  type             ResourceType
  parentResourceId String               @db.VarChar(191)
  parentResource   Resource?            @relation("ResourceChildren", fields: [parentResourceId], references: [id])
  childResources   Resource[]           @relation("ResourceChildren")
  // The owning org
  ownerOrgId       String?
  org              Organization?        @relation(fields: [ownerOrgId], references: [id])
  // The owning user
  ownerUserId      String?
  owner            User?                @relation(fields: [ownerUserId], references: [id])
  accessRules      ResourceAccessRule[]

  // File metadata
  mimeType String? // For files, e.g. 'application/pdf', 'application/vnd.google-apps.document'
  fileUrl  String? // For GCS, signed URLs, or exportable file links

  // External file metadata
  externalSource FileSource? // Indicates origin (e.g., GOOGLE_DRIVE)
  externalId     String? // e.g., Google Drive file ID

  // Link to internal app entities
  linkType     String? // e.g. 'project', 'user', 'task'
  linkTargetId String? // external foreign key or UUID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // unique constraint on slug per parent id
  @@unique([slug, parentResourceId])
}

model ResourceAccessRule {
  id         String             @id @default(cuid())
  resourceId String
  resource   Resource           @relation(fields: [resourceId], references: [id])
  permission ResourcePermission // VIEWER, MANAGER, etc.
  // Grant access to a specific user.
  // Useful for personal files, sharing with contractors, or assigning ownership.
  userId     String?

  // Grant access to all members of a specific organization.
  // Useful when an organization owns or manages shared content like policies or internal resources.
  orgId String?

  // Grant access to all authenticated users in the school, regardless of their organization.
  // Useful for handbooks, newsletters, and public-facing resources restricted to logged-in users.
  allSchool Boolean? @default(false)

  createdAt DateTime @default(now())

  // Prevent duplicates
  @@unique([resourceId, userId])
  @@unique([resourceId, orgId])
  @@unique([resourceId, allSchool])
}

enum ResourcePermission {
  VIEWER
  EDITOR
  MANAGER
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
