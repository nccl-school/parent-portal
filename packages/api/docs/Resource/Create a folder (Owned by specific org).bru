meta {
  name: Create a folder (Owned by specific org)
  type: http
  seq: 4
}

post {
  url: {{API_DOMAIN}}/api/resource/folder
  body: json
  auth: inherit
}

body:json {
  {
    "name": "folder 1",
    "slug": "folder-1",
    "parentResourceId": null,
    "ownership": {
      "level": "org",
      "orgId": "test"
    }
  }
}
