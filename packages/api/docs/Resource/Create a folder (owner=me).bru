meta {
  name: Create a folder (owner=me)
  type: http
  seq: 6
}

post {
  url: {{API_DOMAIN}}/api/resource/folder
  body: json
  auth: inherit
}

body:json {
  {
    "name": "folder 1",
    "slug": "folder-1",
    "parentResourceId": null,
    "ownership": {
      "level": "user",
      "userId": "test"
    }
  }
}
