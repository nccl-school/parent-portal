{
  "name": "@nccl/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "yarn api:build && yarn client:build",
    "api:build": "tsc --project ./tsconfig.build.json",
    "start": "node dist/index.js",
    "webhook:dev": "ngrok http --url=popular-chipmunk-ace.ngrok-free.app 8080",
    "schema:generate": "yarn ts-to-zod prisma/schemas/index.ts prisma/_generated/schemas.ts",
    "client:dev": "yarn client:build --watch",
    "client:build": "yarn tsc --project tsconfig.client.json",
    "db:generate": "prisma generate",
    "db:migrate-dev": "dotenv -e=../../.env -- prisma migrate dev"
  },
  "prisma": {
    "seed": "yarn tsx ./prisma/seed.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist-client/client.js"
  },
  "dependencies": {
    "@clerk/backend": "2.4.0",
    "@hono/clerk-auth": "3.0.1",
    "@hono/node-server": "1.15.0",
    "@hono/zod-validator": "0.7.0",
    "@neondatabase/serverless": "1.0.1",
    "@prisma/adapter-neon": "6.11.1",
    "@prisma/adapter-pg": "6.11.1",
    "@prisma/client": "6.11.1",
    "@prisma/extension-accelerate": "2.0.1",
    "bufferutil": "4.0.9",
    "dotenv": "17.0.1",
    "hono": "4.8.4",
    "leo-profanity": "1.8.0",
    "prisma": "6.11.1",
    "svix": "1.68.0",
    "ws": "8.18.3",
    "zod": "3.25.75"
  },
  "devDependencies": {
    "@clerk/express": "1.7.4",
    "@gfdigital/tsconfig": "0.3.1",
    "@types/express": "^5.0.3",
    "@types/leo-profanity": "1.5.4",
    "@types/node": "24.0.10",
    "@types/ws": "8.18.1",
    "dotenv-cli": "8.0.0",
    "express": "^5.1.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "version": "0.0.1",
  "description": "The API for the NCCL Parent Portal applications",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git"
  },
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme"
}
