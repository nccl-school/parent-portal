{
  "name": "@nccl/api",
  "version": "0.0.1",
  "description": "The API for the NCCL Parent Portal applications",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git"
  },
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.9.3",
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "yarn prisma generate && yarn api:build && yarn client:check && yarn client:build",
    "api:build": "yarn node ./scripts/build.js",
    "start": "node dist/index.js",
    "client:dev": "yarn client:build --watch",
    "client:build": "yarn tsc --project tsconfig.client.json",
    "client:check": "yarn tsc --project tsconfig.client-check.json",
    "db:migrate:dev": "dotenv -e ../../.env -- yarn prisma migrate dev",
    "db:migrate:reset": "dotenv -e ../../.env -- yarn prisma migrate reset"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist-client/client.js"
  },
  "dependencies": {
    "@google-cloud/storage": "7.17.1",
    "@hono/node-server": "1.19.2",
    "@hono/zod-validator": "0.7.2",
    "@nccl/emails": "workspace:*",
    "@nccl/env": "workspace:*",
    "@neondatabase/serverless": "1.0.1",
    "@prisma/adapter-neon": "6.16.1",
    "@prisma/adapter-pg": "6.16.1",
    "@prisma/client": "6.16.1",
    "@prisma/extension-accelerate": "2.0.2",
    "better-auth": "1.3.9",
    "bufferutil": "4.0.9",
    "date-fns": "4.1.0",
    "dotenv": "17.2.2",
    "holycrop": "workspace:*",
    "hono": "4.9.7",
    "leo-profanity": "1.8.0",
    "prisma": "6.16.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "6.0.3",
    "tsx": "4.20.5",
    "ws": "8.18.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@gfdigital/tsconfig": "0.3.1",
    "@playwright/test": "1.55.0",
    "@types/add": "2.0.3",
    "@types/express": "5.0.3",
    "@types/leo-profanity": "1.5.4",
    "@types/node": "24.4.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "add": "2.0.6",
    "dotenv-cli": "10.0.0",
    "esbuild": "0.25.9",
    "esbuild-node-externals": "1.18.0",
    "express": "5.1.0",
    "typescript": "5.9.2"
  }
}
