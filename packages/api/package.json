{
  "name": "@nccl/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "schema:generate": "yarn ts-to-zod prisma/schemas/index.ts prisma/_generated/schemas.ts",
    "client:dev": "yarn client:build --watch",
    "client:build": "yarn tsc --project tsconfig.client.json",
    "db:dev": "prisma dev",
    "db:generate": "prisma generate --no-engine",
    "db:migrate-dev": "dotenv -e=../../.env -- prisma migrate dev"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist.client/index.client.js"
  },
  "dependencies": {
    "@clerk/backend": "^2.1.0",
    "@hono/clerk-auth": "^3.0.0",
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.7.0",
    "@prisma/client": "6.10.1",
    "@prisma/extension-accelerate": "2.0.1",
    "dotenv": "16.5.0",
    "hono": "^4.8.1",
    "hono-openapi": "^0.4.8",
    "prisma": "6.10.1",
    "zod": "^3.25.67",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@gfdigital/tsconfig": "0.3.1",
    "@types/node": "^24.0.3",
    "dotenv-cli": "8.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "version": "0.0.1",
  "description": "The API for the NCCL Parent Portal applications",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git"
  },
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme"
}
