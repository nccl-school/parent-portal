{
  "name": "@nccl/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "yarn api:build && yarn client:check && yarn client:build",
    "api:build": "tsc --project ./tsconfig.build.json",
    "start": "node dist/index.js",
    "webhook:dev": "ngrok http --url=popular-chipmunk-ace.ngrok-free.app 8080",
    "client:dev": "yarn client:build --watch",
    "client:build": "yarn tsc --project tsconfig.client.json",
    "client:check": "yarn tsc --project tsconfig.client-check.json"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist-client/client.js"
  },
  "dependencies": {
    "@clerk/backend": "2.9.0",
    "@google-cloud/storage": "7.16.0",
    "@hono/clerk-auth": "3.0.3",
    "@hono/node-server": "1.18.2",
    "@hono/zod-validator": "0.7.2",
    "@neondatabase/serverless": "1.0.1",
    "@prisma/adapter-neon": "6.14.0",
    "@prisma/adapter-pg": "6.14.0",
    "@prisma/client": "6.14.0",
    "@prisma/extension-accelerate": "2.0.2",
    "bufferutil": "4.0.9",
    "dotenv": "17.2.1",
    "hono": "4.9.1",
    "leo-profanity": "1.8.0",
    "prisma": "6.14.0",
    "svix": "1.73.0",
    "tsx": "4.20.4",
    "ws": "8.18.3",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@clerk/express": "1.7.20",
    "@gfdigital/tsconfig": "0.3.1",
    "@playwright/test": "1.54.2",
    "@types/express": "5.0.3",
    "@types/leo-profanity": "1.5.4",
    "@types/node": "24.2.1",
    "@types/ws": "8.18.1",
    "dotenv-cli": "10.0.0",
    "express": "5.1.0",
    "typescript": "5.9.2"
  },
  "version": "0.0.1",
  "description": "The API for the NCCL Parent Portal applications",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git"
  },
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme"
}
