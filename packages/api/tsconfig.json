{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "#prisma/*": ["./src/_generated/prisma/*"],
      "#utils": ["./src/utils/index.ts"],
      "#middleware": ["./src/middleware/*"],
      "#features/*": ["./src/features/*"],
      "#errors": ["./src/utils/util.errors.ts"]
    }
  },
  "exclude": ["node_modules"]
}
