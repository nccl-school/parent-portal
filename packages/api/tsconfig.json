{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "#prisma": ["./prisma/_generated/edge.js"],
      "#utils": ["./src/utils/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
