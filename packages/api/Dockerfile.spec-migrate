FROM node:24-alpine

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 api-user

COPY --chown=api-user:nodejs /node_modules                              /app/node_modules
COPY --chown=api-user:nodejs /packages/api/dist                         /app/dist
COPY --chown=api-user:nodejs /packages/api/prisma                       /app/prisma
COPY --chown=api-user:nodejs /packages/api/prisma.config.ts             /app/prisma.config.ts
COPY --chown=api-user:nodejs /packages/api/package.json                 /app/package.json
COPY --chown=api-user:nodejs /packages/api/entrypoint.spec-migrate.sh   /app/entrypoint.spec-migrate.sh
RUN chmod +x /app/entrypoint.spec-migrate.sh

ENTRYPOINT ["/app/entrypoint.spec-migrate.sh"]