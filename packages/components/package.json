{
  "name": "@nccl/components",
  "version": "0.0.1",
  "description": "A monorepo library that is built with vite & ts",
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./css": "./dist/components.css"
  },
  "scripts": {
    "icons": "yarn stratum icons build root=./src/icons",
    "build": "yarn icons && yarn build:vite && yarn types",
    "build:vite": "vite build",
    "dev": "yarn build:vite --watch",
    "types": "yarn tsc --project ./tsconfig.types.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@nccl/theme": "0.0.1",
    "@stratum-ui/core": "0.2.0",
    "@stratum-ui/react": "0.2.0",
    "fuse.js": "7.1.0",
    "immer": "10.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sass": "1.93.1",
    "ts-pattern": "5.8.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@gfdigital/tsconfig": "0.3.1",
    "@linaria/core": "6.3.0",
    "@ngneat/falso": "8.0.2",
    "@storybook/addon-a11y": "9.1.7",
    "@storybook/addon-onboarding": "9.1.7",
    "@storybook/react": "9.1.7",
    "@storybook/react-vite": "9.1.7",
    "@stratum-ui/cli": "0.4.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.1",
    "@wyw-in-js/vite": "0.7.0",
    "mockingjson": "0.0.4",
    "storybook": "9.1.7",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
