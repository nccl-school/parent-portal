{
  "name": "@nccl/components",
  "version": "0.0.1",
  "description": "A monorepo library that is built with vite & ts",
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nccl-school/parent-portal.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/nccl-school/parent-portal/issues"
  },
  "homepage": "https://github.com/nccl-school/parent-portal#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./css": "./dist/components.css"
  },
  "scripts": {
    "icons": "yarn stratum icons build root=./src/icons",
    "build": "yarn icons && yarn build:vite && yarn types",
    "build:vite": "vite build",
    "dev": "yarn build:vite --watch",
    "types": "yarn tsc --project ./tsconfig.types.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hugeicons-pro/core-solid-standard": "^1.0.14",
    "@hugeicons-pro/core-stroke-rounded": "^1.0.14",
    "@hugeicons-pro/core-stroke-standard": "^1.0.14",
    "@hugeicons/react": "^1.0.5",
    "@nccl/theme": "0.0.1",
    "@stratum-ui/core": "0.2.0",
    "@stratum-ui/react": "0.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.27.1",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@gfdigital/tsconfig": "0.3.1",
    "@linaria/core": "6.3.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@stratum-ui/cli": "0.4.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "@wyw-in-js/vite": "0.6.0",
    "storybook": "^8.6.14",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
