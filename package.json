{
  "name": "nccl-parent-portal",
  "private": true,
  "version": "0.0.1",
  "description": "A collection of packages and libraries that comprise the NCCL parent portal",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "yarn turbo build",
    "release": "npx changeset publish",
    "test": "yarn vitest --run",
    "lint": "eslint packages/*/src/**/* --fix",
    "e2e:enable": "chmod +x ./scripts/e2e.setup.sh",
    "e2e:up": "./scripts/e2e.setup.sh",
    "e2e:test": "yarn playwright test",
    "e2e:down": "docker compose -f docker-compose.spec.yml down -v"
  },
  "keywords": [
    "typescript",
    "monorepo",
    "template",
    "green-flash-digital",
    "opinionated",
    "boilerplate",
    "starter",
    "yarn",
    "workspaces",
    "turborepo",
    "turbo",
    "vite",
    "vite-library",
    "eslint",
    "vitest",
    "tsconfig",
    "changesets",
    "multi-package",
    "repo-template",
    "build-tooling"
  ],
  "resolutions": {
    "ts-jolt": "0.2.3"
  },
  "devDependencies": {
    "@gfdigital/eslint-config": "0.4.3",
    "@gfdigital/tsconfig": "0.3.1",
    "@types/node": "24.5.2",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@nccl/env": "workspace:",
    "@playwright/test": "1.55.0",
    "dotenv": "17.2.2"
  }
}
