{
  "name": "nccl-parent-portal",
  "private": true,
  "version": "0.0.1",
  "description": "A collection of packages and libraries that comprise the NCCL parent portal",
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "author": "Drew DeCarme (drew@greenflash.digital)",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "yarn turbo build",
    "release": "npx changeset publish",
    "test": "yarn vitest --run",
    "lint": "eslint packages/*/src/**/* --fix",
    "docker-build:local": "docker build . -f packages/app/Dockerfile -t parent-portal-local"
  },
  "keywords": [
    "typescript",
    "monorepo",
    "template",
    "green-flash-digital",
    "opinionated",
    "boilerplate",
    "starter",
    "yarn",
    "workspaces",
    "turborepo",
    "turbo",
    "vite",
    "vite-library",
    "eslint",
    "vitest",
    "tsconfig",
    "changesets",
    "multi-package",
    "repo-template",
    "build-tooling"
  ],
  "resolutions": {
    "ts-jolt": "0.2.3"
  },
  "devDependencies": {
    "@gfdigital/eslint-config": "0.4.3",
    "@gfdigital/tsconfig": "0.3.1",
    "@types/node": "24.0.0",
    "eslint": "9.28.0",
    "prettier": "3.5.3",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "vitest": "3.2.3"
  }
}
